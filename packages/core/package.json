{
  "name": "@acp/core",
  "version": "0.0.1",
  "private": true,
  "description": "Provider-agnostic domain contracts, schemas, and pure logic for Agent Control Plane.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api": {
      "development": "./src/api/index.ts",
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "vitest": "5.0.3"
  }
}
