{
  "name": "@acp/server",
  "version": "0.2.0",
  "private": true,
  "description": "Express REST API, ingestion pipeline wiring, and SSE stream. Owned by P1-D.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "node --conditions=development --import tsx src/main.ts",
    "start": "node dist/main.js",
    "hooks:snippet": "node --conditions=development --import tsx src/hook-snippet.ts"
  },
  "dependencies": {
    "@acp/adapter-claude-code": "workspace:*",
    "@acp/adapter-demo": "workspace:*",
    "@acp/core": "workspace:*",
    "@acp/db": "workspace:*",
    "@acp/orchestrator": "workspace:*",
    "express": "5.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "vitest": "5.0.3"
  }
}
