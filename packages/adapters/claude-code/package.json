{
  "name": "@acp/adapter-claude-code",
  "version": "0.3.1",
  "private": true,
  "description": "Claude Code adapter: session, subagent and hook observation, and managed runs over the Claude Agent SDK.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keerthivibisan/agent-control-plane.git",
    "directory": "packages/adapters/claude-code"
  },
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "sanitize-fixture": "node scripts/sanitize-fixture.ts"
  },
  "dependencies": {
    "@acp/core": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@anthropic-ai/sdk": "0.133.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "vitest": "5.0.3"
  }
}
