{
  "name": "@acp/adapter-claude-code",
  "version": "0.2.0",
  "private": true,
  "description": "Claude Code observation adapter: transcript, subagent metadata, and hook normalization. Owned by P1-C.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "sanitize-fixture": "node scripts/sanitize-fixture.ts"
  },
  "dependencies": {
    "@acp/core": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@anthropic-ai/sdk": "0.133.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "vitest": "5.0.3"
  }
}
