{
  "name": "@acp/adapter-demo",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic demo/test adapter. Demo mode and tests only; never mixed with live data. Owned by P1-C.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@acp/core": "workspace:*"
  },
  "devDependencies": {
    "vitest": "5.0.3"
  }
}
