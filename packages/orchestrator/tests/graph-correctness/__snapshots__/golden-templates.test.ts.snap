// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`template traces > lead-only approve 1`] = `
"#1 owner "create run" -> ok
  > start-agent agentRunId=L kind="lead" prompt="Ticket WEB-12 (feature, medium priority)…"#d46dba2a/657 role="Lead"
  ~ +L lead role="Lead" stage=orchestrate STARTING
#2 Lead "started" -> ok
  > link-session agentRunId=L providerSessionId="sess:L"
  ~ L RUNNING
#3 lead "submit_plan {\\"summary\\":\\"Add a theme stor…"#a34738c3/149 -> ok
  = "Plan v1 submitted. Wait for the owner: y…"#a5080703/102
  > plan-submitted planId=plan1
  ~ run PLAN_REVIEW
  ~ plan1 proposed
#4 owner "plan approve" -> ok
  > plan-decided planId=plan1 status="approved"
  > create-ticket-branch ticketKey="WEB-12"
  > send-to-agent agentRunId=L text="The owner approved plan v1. Start the he…"#d2d6761b/796
  ~ run RUNNING
  ~ plan1 approved
#5 server "ticket branch created" -> ok
#6 lead "start_agent {\\"role\\":\\"Store\\",\\"task\\":\\"Buil…"#e2311af6/73 -> ok
  = "Started agent W1 (Store)."
  > start-agent agentRunId=W1 fromBranch="acp/WEB-12" kind="worker" prompt="Build the Store." role="Store"
  ~ +W1 worker role="Store" stage=helpers STARTING
#7 Store "started" -> ok
  > link-session agentRunId=W1 providerSessionId="sess:W1"
  ~ W1 RUNNING
#8 Store "finish changed" -> ok
  > seal-change agentRunId=W1
  ~ W1 AWAITING_REVIEW change=sealing/r0
#9 server "seal changed" -> ok
  > change-round agentRunId=W1 decidedBy=null decision=null reviewer="lead" reviewerAgentRunId=null round=0 verdict=null
  > send-to-agent agentRunId=L text="Store's change (agentId W1) is ready for…"#6274f5eb/144
  ~ W1 AWAITING_REVIEW change=reviewing/r0
#10 lead "merge_change {\\"agentId\\":\\"W1\\"}" -> ok
  = "Merging Store's change into acp/WEB-12…"
  > merge-change agentRunId=W1 anyway=false by="lead"
#11 server "merged merged" -> ok
  = "Merged Store into acp/WEB-12."
  > change-round agentRunId=W1 decidedBy="lead" decision="merge" reviewer="lead" reviewerAgentRunId=null round=0 verdict=null
  > send-to-agent agentRunId=L text="Every change is decided (1 merged into a…"#c3303363/225
  ~ W1 SUCCEEDED review=merged change=merged/r0
#12 lead "request_review {}" -> ok
  = "Handed over. The final review and tests,…"#0f6444b2/165
  > handover-summary note=null
  ~ run REVIEW
  ~ handedOver=true
#13 owner "merge ticket branch" -> ok
  > abort-agent agentRunId=L
  ~ run COMPLETED
  ~ L CANCELLED
outcome=ended steps=13
final run=COMPLETED
  L lead stage=orchestrate CANCELLED
  W1 worker stage=helpers SUCCEEDED review=merged change=merged/r0"
`;

