  ~ CR1 SUCCEEDED
#13 lead "merge_change {\\"agentId\\":\\"W1\\"}" -> ok
  = "Merging Store's change into acp/WEB-12…"
  > merge-change agentRunId=W1 anyway=false by="lead"
#14 server "merged merged" -> ok
  = "Merged Store into acp/WEB-12."
