  ~ +W1 worker role="Store" stage=helpers STARTING
#7 Store "started" -> ok
  > link-session agentRunId=W1 providerSessionId="sess:W1"
  ~ W1 RUNNING
#8 Store "finish changed" -> ok
  > seal-change agentRunId=W1
  ~ W1 AWAITING_REVIEW change=sealing/r0
#9 server "seal changed" -> ok
  > change-round agentRunId=W1 decidedBy=null decision=null reviewer="agent" reviewerAgentRunId=CR1 round=0 verdict=null
  > create-review-checkout agentRunId=CR1 commit="c0ffee0" reviewsAgentRunId=W1
  > start-agent agentRunId=CR1 kind="reviewer" prompt="Review one helper’s change for \\"WEB-12 D…"#6c28954a/794 reviewScope="change" role="Review: Store"
  ~ W1 AWAITING_REVIEW change=reviewing/r0
  ~ +CR1 reviewer role="Review: Store" stage=review STARTING
#10 Review_Store "started" -> ok
  > link-session agentRunId=CR1 providerSessionId="sess:CR1"
  ~ CR1 RUNNING
#11 Review_Store "submit_review {\\"verdict\\":\\"approve\\",\\"find…"#3fd7efca/61 -> ok
  = "Submitted. Your review is done: end your…"#5e04921c/50
  > review-comment agentRunId=CR1 body="Looks right." changeOf=W1 round=0 verdict="approve"
  > change-round agentRunId=W1 decidedBy=null decision=null reviewer="agent" reviewerAgentRunId=CR1 round=0 verdict="approve"
  > send-to-agent agentRunId=L text="The review agent reviewed Store's change…"#1719b2ed/230
