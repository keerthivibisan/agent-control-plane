  ~ run REVIEW
  ~ handedOver=true
#16 owner "merge ticket branch" -> ok
  > abort-agent agentRunId=L
  ~ run COMPLETED
  ~ L CANCELLED
outcome=ended steps=16
final run=COMPLETED
  L lead stage=orchestrate CANCELLED
  W1 worker stage=helpers SUCCEEDED review=merged change=merged/r0/approve
  CR1 reviewer stage=review SUCCEEDED"
`;

