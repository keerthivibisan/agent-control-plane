exports[`golden v1 traces > control-panel approve 1`] = `
"#1 owner "create run" -> ok
  ~ +L lead role="Lead" stage=- QUEUED
#2 owner "chat" -> ok
  > chat-message role="owner" text="Build the dark mode."
  > start-agent agentRunId=L kind="lead" prompt="Build the dark mode." role="Lead"
  ~ L STARTING
#3 Lead "started" -> ok
  > link-session agentRunId=L providerSessionId="sess:L"
  ~ run RUNNING
  ~ L RUNNING
#4 lead "start_agent {\\"role\\":\\"Store\\",\\"task\\":\\"Buil…"#f0a09a0d/54 -> ok
  = "Started agent W1 (Store)."
  > start-agent agentRunId=W1 kind="worker" prompt="Build the Store." role="Store"
  ~ +W1 worker role="Store" stage=- STARTING
#5 Store "started" -> ok
  > link-session agentRunId=W1 providerSessionId="sess:W1"
  ~ W1 RUNNING
#6 lead "start_agent {\\"role\\":\\"UI\\",\\"task\\":\\"Build the UI.\\"}" -> ok
  = "Started agent W2 (UI)."
  > start-agent agentRunId=W2 kind="worker" prompt="Build the UI." role="UI"
  ~ +W2 worker role="UI" stage=- STARTING
#7 Store "finish success" -> ok
  ~ W1 SUCCEEDED review=pending
#8 UI "started" -> ok
  > link-session agentRunId=W2 providerSessionId="sess:W2"
  ~ W2 RUNNING
#9 UI "finish success" -> ok
  ~ W2 SUCCEEDED review=pending
#10 lead "request_review {}" -> ok
  = "The owner can now review the changes."
  ~ run REVIEW
#11 owner "review merged" -> ok
  ~ W1 SUCCEEDED review=merged
#12 owner "review merged" -> ok
  > abort-agent agentRunId=L
  ~ run COMPLETED
  ~ L CANCELLED
  ~ W2 SUCCEEDED review=merged
outcome=ended steps=12
final run=COMPLETED
  L lead stage=- CANCELLED
  W1 worker stage=- SUCCEEDED review=merged
  W2 worker stage=- SUCCEEDED review=merged"
`;

