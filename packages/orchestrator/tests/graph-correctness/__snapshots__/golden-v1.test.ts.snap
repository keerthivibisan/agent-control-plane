  > link-session agentRunId=W1 provider="claude-code" providerSessionId="sess:W1"
  ~ W1 RUNNING
#6 lead "start_agent {\\"role\\":\\"UI\\",\\"task\\":\\"Build the UI.\\"}" -> ok
  = "Started agent W2 (UI)."
  > start-agent agentRunId=W2 kind="worker" prompt="Build the UI. The app owns branches and …"#d8135f40/224 role="UI"
  ~ +W2 worker role="UI" stage=- STARTING
#7 Store "finish success" -> ok
  > send-to-agent agentRunId=L text="Store (agentId W1) finished: its change …"#1db1b4c4/69
  ~ W1 SUCCEEDED review=pending
#8 UI "started" -> ok
  > link-session agentRunId=W2 provider="claude-code" providerSessionId="sess:W2"
  ~ W2 RUNNING
#9 UI "finish success" -> ok
  > send-to-agent agentRunId=L text="UI (agentId W2) finished: its change wai…"#26ae7c60/66
  ~ W2 SUCCEEDED review=pending
#10 lead "request_review {}" -> ok
  = "The owner can now review the changes."
  ~ run REVIEW
#11 owner "review merged" -> ok
  ~ W1 SUCCEEDED review=merged
#12 owner "review merged" -> ok
  > abort-agent agentRunId=L
  ~ run COMPLETED
  ~ L CANCELLED
  ~ W2 SUCCEEDED review=merged
outcome=ended steps=12
final run=COMPLETED
