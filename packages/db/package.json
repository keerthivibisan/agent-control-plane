{
  "name": "@acp/db",
  "version": "0.3.2",
  "private": true,
  "description": "SQLite persistence for Agent Control Plane: migrations, repositories, transactions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keerthivibisan/agent-control-plane.git",
    "directory": "packages/db"
  },
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@acp/core": "workspace:*",
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "vitest": "5.0.3"
  }
}
